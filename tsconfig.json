{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": ".",

    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "node",
    "resolveJsonModule": true
  },

  "include": [
    "server/**/*",
    "shared/**/*"
  ],

  "exclude": [
    "client",
    "script",
    "vite.config.ts",
    "**/*.test.ts",
    "node_modules",
    "dist"
  ]
}
