{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "rootDir": ".",
    "outDir": "dist",

    "moduleResolution": "node",
    "resolveJsonModule": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "allowJs": false
  },

  "include": ["server/**/*", "shared/**/*"],

  "exclude": [
    "client",
    "script",
    "client/vite.config.ts",
    "server/vite.ts",
    "**/*.test.ts",
    "node_modules",
    "dist"
  ]
}
